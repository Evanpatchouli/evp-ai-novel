{
  "name": "evp-ai-novel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist/",
    "client/",
    "server/",
    "shared/",
    "scripts/",
    "tests/",
    "third-party/",
    "tsconfig.base.json",
    "vitest.config.ts"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --config client/vite.config.ts",
    "build:server": "tsc -p server/tsconfig.json && npm run build:git && npm run test:bundled-git",
    "build:git": "tsx scripts/bundle-mingit.ts",
    "prepack": "npm run build",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:bundled-git": "node scripts/test-bundled-git.mjs",
    "test:watch": "vitest",
    "benchmark:stage2": "tsx scripts/benchmark-stage2.ts",
    "benchmark:stage6": "tsx scripts/benchmark-stage6.ts",
    "format": "prettier --write \"client/**/*.{ts,tsx,css,html}\" \"server/**/*.ts\" \"shared/**/*.ts\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.ts\" \"*.{json,ts,md}\"",
    "typecheck": "tsc -p client/tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@koa/router": "^15.7.0",
    "@ldkj/web-ui": "^1.10.1",
    "archiver": "^7.0.1",
    "diff": "^8.0.2",
    "es-toolkit": "^1.49.0",
    "fast-glob": "^3.3.3",
    "js-yaml": "^4.1.0",
    "koa": "^3.0.3",
    "koa-bodyparser": "^4.4.1",
    "koa-static": "^5.0.0",
    "overlayscrollbars": "^2.17.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.1",
    "remark-gfm": "^4.0.1",
    "unzipper": "^0.12.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/archiver": "^6.0.3",
    "@types/js-yaml": "^4.0.9",
    "@types/koa": "^2.15.0",
    "@types/koa__router": "^12.0.4",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/koa-static": "^4.0.4",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^6.0.3",
    "@types/unzipper": "^0.10.11",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.2.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.0"
  },
  "license": "GPL-3.0-only",
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
